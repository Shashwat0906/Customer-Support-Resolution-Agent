# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------- core
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://support:support@localhost:5432/support_agent
# explicit origins only (no * in production)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ---------------------------------------------------------------- auth (demo JWT)
# required in production
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_TTL_MINUTES=720
# demo persona login; synthetic data only
DEMO_AUTH_ENABLED=true

# ---------------------------------------------------------------- mock external services
PAYMENTS_BASE_URL=http://localhost:8001/payments
SHIPPING_BASE_URL=http://localhost:8001/shipping
TICKETING_BASE_URL=http://localhost:8001/ticketing
# shared secret between API and mock payment provider
PAYMENTS_API_KEY=dev-payments-key
# protects mock admin/fault endpoints; change in production
MOCK_ADMIN_TOKEN=dev-mock-admin-token
EXTERNAL_TIMEOUT_SECONDS=3

# ---------------------------------------------------------------- LLM (optional; default is the free deterministic mock)
# mock | anthropic | openai
LLM_PROVIDER=mock
# anthropic default: claude-opus-5-5
LLM_MODEL=
# required for anthropic/openai; empty => falls back to mock
LLM_API_KEY=
LLM_BASE_URL=
# anthropic effort: low | medium | high | xhigh | max
LLM_EFFORT=medium
# used for cost estimates only
LLM_INPUT_COST_PER_MTOK=4.0
LLM_OUTPUT_COST_PER_MTOK=20.0

# ---------------------------------------------------------------- embeddings
# local (deterministic hashing) | openai (OpenAI-compatible endpoint)
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=256

# ---------------------------------------------------------------- workflow limits
# specialist | single
AGENT_MODE=specialist
MAX_WORKFLOW_STEPS=40
MAX_COST_USD_PER_RUN=0.50
MAX_AGENT_ITERATIONS=6
MAX_READ_RETRIES=3
APPROVAL_TTL_MINUTES=1440

# ---------------------------------------------------------------- worker
# true = worker thread inside the API process (single-container hosting)
RUN_EMBEDDED_WORKER=false
JOB_LEASE_SECONDS=120

# ---------------------------------------------------------------- frontend (build time)
VITE_API_BASE_URL=http://localhost:8000
